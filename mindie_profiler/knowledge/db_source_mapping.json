  "pmu_units": {
    "ns": "nanoseconds, full-event values",
    "cycles": "cycles, full-event values",
    "ratio": "fraction 0..1, full-event values",
    "percent": "percent 0..100, full-event values",
    "unknown": "unmapped metric unit"
  }
