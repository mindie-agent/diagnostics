      "csv_column": "aic_icache_miss_rate",
      "csv_scale": 1.0
    },
    "aiv_total_time": {
      "db_metric": "aiv_total_time",
      "unit": "ns",
      "csv_column": "aiv_time(us)",
      "csv_scale": 1000.0
    },
    "aiv_total_cycles": {
      "db_metric": "aiv_total_cycles",
      "unit": "cycles",
      "csv_column": "aiv_total_cycles",
      "csv_scale": 1.0
    },
    "aiv_vec_time": {
      "db_metric": "aiv_vec_time",
      "unit": "ns",
